        "@tailwindcss/upgrade": "^4.3.3",
        "@types/node": "^26.5.1",
        "autoprefixer": "^10.6.0",
        "baseline-browser-mapping": "^2.11.23",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "form-data": "^4.0.6",
        "laravel-vite-plugin": "^3.2.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
