# Copy to .env (gitignored) and fill in real values:
#
#   cp scripts/import-tool/.env.example scripts/import-tool/.env
#
# This file is NOT auto-loaded. The importer services live in the root
# compose.yml under the `import` profile, but their credentials deliberately
# do not live in the project root, so every command passes it explicitly:
#
#   docker compose --env-file scripts/import-tool/.env --profile import \
#     run --rm <service>
#
# All three modes (backup-permissions / stage / ship) read the same file;
# vars a given mode doesn't need are simply ignored, and the mounts it
# doesn't need aren't given to it at all — `stage` never gets the SSH key,
# `ship` never gets the legacy database or images.

# --- OVH connection ---------------------------------------------------------
# Used by backup-permissions and ship. `stage` never dials out.
OVH_HOST=51.75.246.163
OVH_USER=deploy
OVH_APP_DIR=/opt/inventory/current
OVH_SHARED_DIR=/opt/inventory/shared

# Host path to the deploy SSH private key (Windows example shown).
# Referenced by compose.yml's volumes section as OVH_SSH_KEY_HOST_PATH.
OVH_SSH_KEY_HOST_PATH=C:\users\phave\.ssh\inventory_deploy

# --- Legacy source ----------------------------------------------------------
# Read by `stage` only, over the VPN. Nothing here ever reaches OVH: `ship`
# works from the staged copy and is not given these mounts or this database.
LEGACY_DB_HOST=192.168.255.157
LEGACY_DB_PORT=3306
LEGACY_DB_USER=havelpa
LEGACY_DB_PASSWORD=
LEGACY_DB_DATABASE=mwnf3

# Host path to the legacy images source. Referenced by compose.yml's volumes
# section as LEGACY_IMAGES_HOST_PATH — mounted read-only at /legacy-images
# inside the container (LEGACY_IMAGES_ROOT is set for you).
LEGACY_IMAGES_HOST_PATH=Z:\mwnf\images

# The legacy server's image tree, over the VPN. Read only by
# Sync-LegacyImages.ps1, which mirrors it into LEGACY_IMAGES_HOST_PATH before
# a stage; no container mounts it. Keep the single quotes: Compose reads this
# file too, and they keep the `$` of an administrative share literal.
LEGACY_IMAGES_SOURCE='\\virtual-office.museumwnf.org\c$\mwnf-server\pictures\images'

# The staged database is not configured here. `stage` writes to the compose
# `staging-mysql` service and `ship` dumps from it; both get those values from
# compose.yml, not from this file, so no production database is reachable
# through the importer's own configuration.

# --- Auth/permissions snapshot ---------------------------------------------
# Fixed "current" pointer on the OVH host (survives releases). Overwritten by
# backup-permissions, read by ship's auth:restore step.
AUTH_SNAPSHOT_REMOTE=/opt/inventory/shared/auth-snapshots/current.json.enc

# Host directory for redundant local, timestamped copies of the snapshot.
# Referenced by compose.yml's volumes section as AUTH_SNAPSHOT_BACKUP_HOST_PATH
# (defaults to ./scripts/import-tool/auth-backups if unset).
# AUTH_SNAPSHOT_BACKUP_HOST_PATH=./scripts/import-tool/auth-backups

# --- ship mode: fallback account recreation ---------------------------------
# Only used if AUTH_SNAPSHOT_REMOTE does not exist on the OVH host when
# "ship" runs (i.e. no prior backup-permissions run). Both must be set
# together or ship refuses to proceed rather than partially creating one
# account. user:create does not set a plaintext password — it emails a
# password-reset invitation to that address, and each account gets exactly
# one fixed role (ADMIN_EMAIL -> "Manager of Users", REGULAR_USER_EMAIL ->
# "Regular User"). Leave both unset to keep today's behavior (ship fails
# hard with no snapshot, nothing is created).
# ADMIN_EMAIL=you@example.com
# REGULAR_USER_EMAIL=you+regular@example.com

# --- ship mode safety guard --------------------------------------------------
# Required verbatim for "ship" mode to proceed. Left commented out on
# purpose — uncomment only when you actually intend to wipe the database.
# Better: don't set it here at all — pass it inline on the command line only
# when you mean it, so it's a deliberate choice each time, not a standing
# value that silently authorizes every future run. Compose reads it from the
# invoking shell, not from this file:
#
#   $env:CONFIRM_WIPE = 'yes-really-wipe-production'   # PowerShell
#   CONFIRM_WIPE=yes-really-wipe-production            # bash, inline
#
# CONFIRM_WIPE=yes-really-wipe-production
