{
  "name": "importer",
  "version": "2.0.9",
  "private": true,
  "type": "module",
  "description": "Unified legacy database import utility for Inventory Management System",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "import:api": "tsx src/cli/api-import.ts",
    "import:sql": "tsx src/cli/sql-import.ts",
    "import": "tsx src/cli/import.ts import",
    "image-sync": "tsx src/cli/import.ts image-sync"
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "axios": "^1.20.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "marked": "^18.0.14",
    "mysql2": "^3.24.5",
    "turndown": "^7.2.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
