{
  "name": "site-i18n-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Extracts legacy DXA UI strings into vue-i18n message files when a gallery or exhibition website is scaffolded (THG G3, issue #1521)",
  "scripts": {
    "build": "tsc",
    "list": "tsx src/cli/list.ts",
    "extract": "tsx src/cli/extract.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.4",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
