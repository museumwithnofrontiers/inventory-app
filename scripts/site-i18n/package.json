{
  "name": "site-i18n-extractor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Extracts legacy DXA UI strings into vue-i18n message files when a gallery or exhibition website is scaffolded (THG G3, issue #1521)",
  "scripts": {
    "build": "tsc",
    "list": "tsx src/cli/list.ts",
    "extract": "tsx src/cli/extract.ts",
    "extract:explore": "tsx src/cli/extract-explore.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "@vue/compiler-sfc": "^3.5.43",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "mysql2": "^3.24.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
