# Where the exported data comes from.
#
# Leave unset for the normal flow: the viewer takes
# @museumwnf/water-in-islam-data when it is installed, and otherwise
# falls back to the exporter's own output at
# ../../exporters/water-in-islam/output/water-in-islam.
# The published package is what CI and the deploy workflow build against; the
# fallback is for working against data that has not been published yet —
# produce it with
#
#   docker compose --profile jobs run --rm \
#       exporter water-in-islam --force \
#       --base-url https://inventory.metanull.eu
#
# Set this to override an installed package: an npm package name, or a path to
# any directory holding a manifest.json.
# DATA_PACKAGE=@museumwnf/water-in-islam-data

# Host serving the legacy chrome images (exhibition banner / home image) and the
# related-content PDFs. These were never imported into inventory storage — the
# data package ships the legacy path and the viewer supplies the host, exactly
# as the legacy client did through VUE_APP_IMAGES_URL. Change it only if the
# media server moves.
# VITE_LEGACY_IMAGES_URL=https://images.museumwnf.org
