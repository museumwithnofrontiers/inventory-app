# Where the exported data comes from.
#
# Leave unset for the normal flow: the viewer takes @museumwnf/carpets-data when
# it is installed, and otherwise falls back to the exporter's own output at
# ../../exporters/dxa-gallery/output/carpets. The package is NOT published yet, so
# today that fallback is what serves the viewer — produce it with
#
#   docker compose --profile jobs run --rm exporter dxa-gallery --instance carpets --force \
#       --base-url https://inventory.metanull.eu
#
# Set this to override: an npm package name, or a path to any directory holding
# a manifest.json.
# DATA_PACKAGE=@museumwnf/carpets-data

# Host serving the legacy gallery chrome images (gallery banner / thumbnail).
# These were never imported into inventory storage — the data package ships the
# legacy path and the viewer supplies the host, exactly as the legacy client did
# through VUE_APP_IMAGES_URL. Change it only if the media server moves.
# VITE_LEGACY_IMAGES_URL=https://images.museumwnf.org
