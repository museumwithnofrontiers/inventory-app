# Inventory database (same as importer DB_* variables)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=inventory
DB_PASSWORD=
DB_DATABASE=inventory

# Base URL prepended to image paths in the exported JSON.
# Default (when unset): ./images  — relative to wherever the JSON files are served from.
# Set this to your CDN or storage URL when the images are hosted elsewhere.
# BASE_URL=https://cdn.example.com/storage

# npm publish metadata (used with --publish flag)
# PACKAGE_AUTHOR=Your Name <you@example.com>
# PACKAGE_LICENSE=SEE LICENSE IN LICENSE.md
# (default; LICENSE.md is a copy of docs/LICENSE.md.template, the MWNF legal notice — override only for a fork published under different terms)
# PACKAGE_REPO_URL=https://github.com/your-org/your-repo
# npmjs (registry.npmjs.org) is the default registry; no override needed.
