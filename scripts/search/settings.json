{
  "$comment": "Meilisearch settings of the items index (ADR 005, M15 B2). The loader expands every 'texts.*.' field to each language of the package's manifest, in this order. Reference numbers match exactly: no typo tolerance on them. The dates are filterable for the search site's From/To years. A change here loads the pinned version again (the loader's settings fingerprint).",
  "locales": {
    "ar": "ara",
    "ch": "cmn",
    "cs": "ces",
    "de": "deu",
    "el": "ell",
    "en": "eng",
    "es": "spa",
    "fa": "pes",
    "fr": "fra",
    "he": "heb",
    "hr": "hrv",
    "hu": "hun",
    "it": "ita",
    "pt": "por",
    "ru": "rus",
    "se": "swe",
    "si": "slv",
    "tr": "tur"
  },
  "searchable": [
    "texts.*.name",
    "texts.*.names",
    "mwnf_reference",
    "owner_reference",
    "backward_compatibility",
    "id",
    "texts.*.tags",
    "tags",
    "texts.*.keywords",
    "texts.*.materials",
    "texts.*.dynasty",
    "texts.*.artist",
    "texts.*.type",
    "texts.*.short_description",
    "texts.*.place",
    "texts.*.holder",
    "texts.*.partner",
    "texts.*.country",
    "texts.*.dates",
    "texts.*.history",
    "texts.*.description"
  ],
  "displayed": [
    "id",
    "type",
    "parent_id",
    "picture",
    "sites",
    "languages",
    "start_date",
    "end_date",
    "texts.*.name",
    "texts.*.partner",
    "texts.*.dates",
    "texts.*.country"
  ],
  "filterable": ["type", "languages", "sites.site", "start_date", "end_date"],
  "sortable": ["start_date"],
  "exact": ["mwnf_reference", "owner_reference", "backward_compatibility", "id"],
  "synonyms": {
    "lustre": ["luster"],
    "luster": ["lustre"],
    "colour": ["color"],
    "color": ["colour"]
  },
  "maxTotalHits": 1000
}
